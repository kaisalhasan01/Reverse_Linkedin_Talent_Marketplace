# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# --- Database (Postgres) ---
# Local dev: run `npm run db:dev` (embedded Postgres, no install needed) and use:
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:5433/reverse"
# Production (Supabase): use the pooled connection string instead, e.g.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# --- Auth.js / NextAuth ---
# Generate with:  openssl rand -base64 33
AUTH_SECRET=""

# --- Stripe (later phase) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
